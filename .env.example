# Copy to .env for local use. On Vercel/Render/etc. add these as Environment Variables instead.

# --- Speech-to-text ---
# Free key at https://console.groq.com/keys  (Whisper large-v3, ~8 h of audio/day free)
GROQ_API_KEY=
# STT_ENGINE=groq        # groq | local  (local = offline Whisper, needs requirements-local.txt)

# --- Protect your deployment (strongly recommended when it's online) ---
APP_PASSWORD=Student

# --- AI tools (summary, clean-up, speakers) ---
# Leave all three empty to use Groq's free LLMs with the GROQ_API_KEY above.
# Or use OpenRouter (free models picked automatically):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...
AI_MODEL=auto
