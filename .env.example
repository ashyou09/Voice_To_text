# Copy this file to .env (never commit .env to GitHub), then restart the app.

# Any OpenAI-compatible server. Examples:
#   OpenRouter : https://openrouter.ai/api/v1   (needs a key)
#   Local proxy: http://localhost:20128/v1
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
# "auto" asks the server which models it has and picks a good one.
# On OpenRouter, auto uses the free router (openrouter/free). Or set an exact model name.
AI_MODEL=auto
